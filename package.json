{
  "name": "opencode-deepseek-peak",
  "version": "0.2.0",
  "description": "OpenCode V2 plugin showing DeepSeek peak and off-peak pricing periods",
  "type": "module",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "deepseek",
    "pricing",
    "peak",
    "off-peak",
    "tui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiev/opencode-deepseek-peak.git"
  },
  "license": "MIT",
  "exports": {
    ".": {
      "import": "./index.js"
    },
    "./rpc": {
      "import": "./dist/rpc.js"
    },
    "./tui": {
      "import": "./tui/index.js"
    }
  },
  "files": [
    "index.js",
    "dist",
    "src",
    "tui",
    "install.mjs",
    "README.md"
  ],
  "bin": {
    "opencode-deepseek-peak": "install.mjs"
  },
  "scripts": {
    "build": "node build.mjs",
    "build:tui": "node build.tui.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "date-holidays": "^3.26.5",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.16",
    "@opencode-ai/sdk": "^1.18.16",
    "@opencode/plugin": "^2.0.16",
    "@opentui/core": "^0.5.10",
    "@opentui/solid": "^0.5.10",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "esbuild-plugin-solid": "^0.6.0",
    "solid-js": "^1.9.0",
    "tsx": "^4.22.3",
    "typescript": "^5.8.0"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.0",
    "@opentui/core": ">=0.5.8",
    "@opentui/solid": ">=0.5.8",
    "solid-js": ">=1.9.0"
  }
}
